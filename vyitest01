    <script>
        // 手機漢堡選單切換
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
            if (mobileMenu.classList.contains('hidden')) {
                menuIcon.className = 'fa-solid fa-bars text-2xl';
            } else {
                menuIcon.className = 'fa-solid fa-xmark text-2xl';
            }
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                menuIcon.className = 'fa-solid fa-bars text-2xl';
            });
        });

        // 1. 深淺色模式切換邏輯
        const themeToggleDesktop = document.getElementById('theme-toggle-desktop');
        const themeToggleMobile = document.getElementById('theme-toggle-mobile');

        function toggleDarkMode() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        // 讀取偏好模式
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }

        themeToggleDesktop.addEventListener('click', toggleDarkMode);
        themeToggleMobile.addEventListener('click', toggleDarkMode);

        // 2. 背景音樂控制邏輯
        const bgMusic = document.getElementById('bg-music');
        const musicToggleBtn = document.getElementById('music-toggle-btn');
        const musicIcon = document.getElementById('music-icon');
        const musicStatusText = document.getElementById('music-status-text');
        const soundWave = document.getElementById('sound-wave');
        let isPlaying = false;

        function toggleMusic() {
            if (isPlaying) {
                bgMusic.pause();
                musicIcon.className = 'fa-solid fa-music';
                musicStatusText.textContent = '點擊播放';
                soundWave.classList.add('hidden');
                isPlaying = false;
            } else {
                bgMusic.play().then(() => {
                    musicIcon.className = 'fa-solid fa-pause';
                    musicStatusText.textContent = '播放中';
                    soundWave.classList.remove('hidden');
                    isPlaying = true;
                }).catch(err => {
                    console.log('音樂自動播放不受瀏覽器預設允許，需要手動點擊', err);
                });
            }
        }

        musicToggleBtn.addEventListener('click', toggleMusic);

        // 表單送出處理
        function handleFormSubmit(event) {
            event.preventDefault();
            const form = document.getElementById('contact-form');
            const messageBox = document.getElementById('form-message');

            form.reset();
            messageBox.classList.remove('hidden');

            setTimeout(() => {
                messageBox.classList.add('hidden');
            }, 5000);
        }
    </script>
